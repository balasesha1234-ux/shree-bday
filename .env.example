# =========================================================================
# Shree 4.0 Birthday Celebration — Environment Configuration Template
# =========================================================================

# 1. Supabase Cloud Configuration (Optional but recommended for live persistence)
# Copy these from your Supabase Project Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 2. Production Domain URL
VITE_PUBLIC_URL=https://my-love-bday.vercel.app

# Note: If Supabase keys are not set, the platform will automatically 
# use high-speed local memory & rate-limited localStorage fallbacks 
# without breaking any features!
